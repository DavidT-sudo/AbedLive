# Postgres connection string
DATABASE_URL="postgresql://abedlive:changeme@localhost:5432/abedlive"

# Better Auth
BETTER_AUTH_SECRET="generate-a-long-random-string"
# Your real public URL in production (e.g. https://abedlive.com).
# http://localhost:3000 is fine for local dev.
BETTER_AUTH_URL="http://localhost:3000"

# SeaweedFS S3 gateway (self-hosted). Also works with any S3-compatible endpoint.
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_BUCKET="abedlive-media"
S3_ACCESS_KEY_ID="changeme"
S3_SECRET_ACCESS_KEY="changeme"
# Public base URL used to build media links returned to the browser —
# must be externally reachable in production, not localhost.
S3_PUBLIC_URL="http://localhost:8333/abedlive-media"
# Force path-style addressing (required for SeaweedFS / most self-hosted S3 gateways)
S3_FORCE_PATH_STYLE="true"
